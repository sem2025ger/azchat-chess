PORT=4000
FRONTEND_URL=http://localhost:5173
# New durable starts are disabled by default. Existing durable games always drain.
# Apply the additive migration and obtain separate activation approval first.
DURABLE_ACTIVE_GAMES=false

# Games Database v1. Defaults: Lichess enabled; own database and import disabled.
# Set only on the server after owner review; never use VITE_ for credentials.
GAMES_LICHESS_ENABLED=
GAMES_DB_ENABLED=
TWIC_IMPORT_ENABLED=
# Optional Lichess OAuth token. Required by the current Masters statistics API.
LICHESS_API_TOKEN=
# Maximum total database size in MiB, default 300, enforced at or below 300.
TWIC_MAX_DB_MB=
# Existing server-only Supabase credential path; use QA for this milestone.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional verified reverse-proxy hop count (0 by default; ignore spoofable headers).
# Owner must verify Render's actual chain before setting this for per-client limits.
GAMES_TRUST_PROXY_HOPS=
